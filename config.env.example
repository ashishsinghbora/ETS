# ==============================================================================
# Encrypted Tiered Cloud Storage - Configuration
# ==============================================================================

# --- Remote Settings ---
# Name of your existing, configured unencrypted cloud remote (e.g. gdrive, onedrive, dropbox)
CLOUD_REMOTE="gdrive"

# Subfolder on the cloud remote where encrypted blobs will be stored
CLOUD_REMOTE_FOLDER="encrypted"

# Name of the rclone crypt remote to create
CRYPT_REMOTE="gcrypt"

# Encryption password (leave blank to auto-generate a secure 32-char password)
CRYPT_PASSWORD=""

# --- Mount & Storage Paths ---
# Use rootless user directories (~/mnt/...) or custom absolute paths
STORAGE_BASE_DIR="$HOME/mnt"
LOCAL_CACHE_DIR="$STORAGE_BASE_DIR/local-cache"
CLOUD_REMOTE_MOUNT="$STORAGE_BASE_DIR/gcrypt-remote"
TIERED_MOUNT="$STORAGE_BASE_DIR/cloud-tiered"

# --- Tier Sync Settings (Routine Time Rule) ---
# Move files older than this threshold from local cache to cloud
SYNC_MIN_AGE="15m"

# Sync timer frequency (e.g. 15m, 20m, 30m)
SYNC_INTERVAL="20m"

# Bandwidth throttle for cloud offload (e.g. 5M, 10M, 0 for unlimited)
SYNC_BWLIMIT="5M"

# Max parallel transfers and checkers (recommended 2 for SBC / low-resource devices)
SYNC_TRANSFERS="2"
SYNC_CHECKERS="2"

# --- Hybrid Eviction Settings (Emergency Panic Rule) ---
# Trigger emergency LRU eviction if local cache disk usage % reaches or exceeds this
PANIC_THRESHOLD="80"

# Target local cache disk usage % to reach before stopping emergency LRU eviction
PANIC_TARGET="60"

# --- Smart Filer (Optional Auto-Organization) ---
# Automatically route docs to Documents/, photos to Photos/YYYY/MM/, and archive inactive git repos
SMART_FILER_ENABLED="false"

# --- Telegram Alerting (Optional) ---
# Set to "true" to enable instant failure notifications
TELEGRAM_ALERTS_ENABLED="true"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Generic Webhook Alerting (Optional fallback) ---
# POSTs {"text": "message"} to any custom webhook URL (Discord, Slack, n8n, etc.)
WEBHOOK_URL=""
